#!/usr/bin/env python3
"""kimono-hadith BOOK NUMBER     e.g. kimono-hadith bukhari 1

Reads a hadith exactly as the chat shows it when you cite it in a ```hadith
block: its chapter, the Arabic, the English and French where there is one,
and its grades. Read it before you cite it: if it isn't the hadith you meant,
the number is wrong, so don't cite it.

Books (sunnah.com's numbering): bukhari, muslim, abudawud, tirmidhi, nasai,
ibnmajah, malik, nawawi (the Forty), qudsi.
"""
import json, os, re, sys, urllib.error, urllib.request

BOOKS = {"bukhari": "Sahih al-Bukhari", "muslim": "Sahih Muslim", "abudawud": "Sunan Abi Dawud", "tirmidhi": "Jami' at-Tirmidhi", "nasai": "Sunan an-Nasa'i", "ibnmajah": "Sunan Ibn Majah", "malik": "Muwatta Malik", "nawawi": "An-Nawawi's Forty", "qudsi": "Forty Hadith Qudsi"}


def get(path, required=True):
    base = os.environ.get("ANTHROPIC_BASE_URL", "")
    token = os.environ.get("ANTHROPIC_API_KEY", "")
    if os.environ.get("KIMONO_SCRIPTURE_URL"):  # the evals' stand-in for the gateway
        base, token = os.environ["KIMONO_SCRIPTURE_URL"].rstrip("/") + "/anthropic", "eval"
    if not base.endswith("/anthropic") or not token:
        sys.exit("kimono-hadith: this computer can't reach Kimono")
    request = urllib.request.Request(base[: -len("/anthropic")] + "/scripture/hadith/" + path, headers={"Authorization": f"Bearer {token}"})
    try:
        with urllib.request.urlopen(request, timeout=40) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        if not required:
            return None
        sys.exit("kimono-hadith: there's no such hadith" if error.code == 404 else f"kimono-hadith: {error.reason}")
    except OSError as error:
        if not required:
            return None
        sys.exit(f"kimono-hadith: couldn't reach the collection ({error})")


args = sys.argv[1:]
if len(args) != 2 or args[0] in ("-h", "--help"):
    sys.exit(__doc__.strip())
book, number = args[0].lower(), args[1]
if book not in BOOKS or not number.isdigit():
    sys.exit("kimono-hadith: books are " + ", ".join(BOOKS))
eng = get(f"eng-{book}/{number}.min.json")
ara = get(f"ara-{book}/{number}.min.json", required=False)
fra = None if book == "tirmidhi" else get(f"fra-{book}/{number}.min.json", required=False)
first = (eng.get("hadiths") or [{}])[0]
section = next(iter((eng.get("metadata", {}).get("section") or {}).values()), None)
print(f"{BOOKS[book]} {number}" + (f", {section}" if section else ""))
arabic = ((ara or {}).get("hadiths") or [{}])[0].get("text", "").strip()
if arabic:
    print(f"\nAR: {arabic}")
if first.get("text"):
    print(f"\nEN: {first['text'].strip()}")
french = ((fra or {}).get("hadiths") or [{}])[0].get("text", "").strip()
if french:
    print(f"\nFR: {french}")
grades = [f"{g['grade']} ({g['name']})" for g in first.get("grades", []) if g.get("grade")]
print("\nGrades: " + ("; ".join(grades) if grades else "none given in this collection"))
print(f"Source: hadith-api by fawazahmed0 (https://github.com/fawazahmed0/hadith-api), sunnah.com numbering: https://sunnah.com/{ {'nawawi': 'nawawi40', 'qudsi': 'qudsi40'}.get(book, book) }:{number}")
