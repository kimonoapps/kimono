#!/usr/bin/env python3
"""kimono-ask <<'EOF'
{"questions": [{"question": "Did you like it?", "header": "Liked it",
  "options": [{"label": "Loved it"}, {"label": "It's fine"}, {"label": "Not really"}],
  "multi": false}]}
EOF

Asks the person one to four questions. Their writing bar turns into the
questions: each has two to four options to tap (multi: true lets them pick
several), and they can always write their own answer instead. "header" is a
short name for the question (a few words); an option may have a "description".
Ask, then end your turn with nothing more: their answers come as their next message.
"""
import json, os, secrets, sys, time

if sys.argv[1:2] in (["-h"], ["--help"]):
    sys.exit(__doc__.strip())
raw = open(sys.argv[1], encoding="utf-8").read() if sys.argv[1:] else sys.stdin.read()
try:
    asked = json.loads(raw)
except ValueError as error:
    sys.exit(f"kimono-ask: that isn't JSON ({error})")
if isinstance(asked, list):
    asked = {"questions": asked}
questions = asked.get("questions") if isinstance(asked, dict) else None
if not isinstance(questions, list) or not 1 <= len(questions) <= 4:
    sys.exit("kimono-ask: give one to four questions")

def text(value, most, what):
    if not isinstance(value, str) or not " ".join(value.split()):
        sys.exit(f"kimono-ask: {what} can't be empty")
    value = " ".join(value.split())
    if len(value) > most:
        sys.exit(f"kimono-ask: keep {what} under {most} characters")
    return value

clean = []
for n, q in enumerate(questions, 1):
    if not isinstance(q, dict):
        sys.exit(f"kimono-ask: question {n} should be an object")
    options = q.get("options")
    if not isinstance(options, list) or not 2 <= len(options) <= 4:
        sys.exit(f"kimono-ask: question {n} needs two to four options (they can always write their own too)")
    kept = []
    for o in options:
        o = {"label": o} if isinstance(o, str) else o
        if not isinstance(o, dict):
            sys.exit(f"kimono-ask: question {n}'s options should be objects with a label")
        option = {"label": text(o.get("label"), 80, "an option's label")}
        if o.get("description"):
            option["description"] = text(o["description"], 160, "an option's description")
        kept.append(option)
    if len({o["label"].lower() for o in kept}) < len(kept):
        sys.exit(f"kimono-ask: question {n} has the same option twice")
    item = {"question": text(q.get("question"), 200, "a question"), "options": kept, "multi": q.get("multi") is True}
    if q.get("header"):
        item["header"] = text(q["header"], 30, "a header")
    clean.append(item)

folder = os.environ.get("KIMONO_QUESTIONS_DIR", "/workspace/.kimono/questions")
os.makedirs(folder, exist_ok=True)
qid = f"{int(time.time() * 1000)}-{secrets.token_hex(4)}"
with open(f"{folder}/.{qid}.json", "w", encoding="utf-8") as f:
    json.dump({"questions": clean}, f)
os.rename(f"{folder}/.{qid}.json", f"{folder}/{qid}.json")
print(f"Asked (question {qid}). End your turn now without saying anything more; their answers come as their next message.")
