#!/usr/bin/env python3
"""kimono-link FILE [--hours N]

Makes a temporary public https link to a file here, for a tool that takes a
file by link (a photo to turn into a video, a picture to edit, a sound to
transcribe). It prints the link; pass that to the tool. It lasts two hours,
or N hours (up to 24), and only works for this file as it is now: run it
again after you change the file. Up to 50 MB. For tools, not for the person:
give them files with kimono-send.
"""
import hashlib, hmac, os, re, secrets, shutil, sys, time, urllib.parse

MAX_BYTES = 50 * 1024 * 1024
LINKS = "/workspace/.kimono/links"

args = sys.argv[1:]
hours = 2.0
if "--hours" in args:
    i = args.index("--hours")
    try:
        hours = float(args[i + 1])
    except (IndexError, ValueError):
        sys.exit("kimono-link: --hours takes a number, such as --hours 6")
    del args[i:i + 2]
if len(args) != 1 or args[0] in ("-h", "--help"):
    sys.exit(__doc__.strip())
if not 0 < hours <= 24:
    sys.exit("kimono-link: a link can last up to 24 hours")

base = os.environ.get("KIMONO_LINKS", "")
if not base:
    sys.exit("kimono-link: this Kimono can't make links to files right now")

path = os.path.realpath(args[0])
if os.path.isdir(path):
    sys.exit(f"kimono-link: {args[0]} is a folder; zip it first (zip -r name.zip {args[0]})")
if not os.path.isfile(path):
    sys.exit(f"kimono-link: there's no file {args[0]}")
if os.path.getsize(path) > MAX_BYTES:
    sys.exit(f"kimono-link: {args[0]} is over 50 MB")

stem, ext = os.path.splitext(os.path.basename(path))
stem = re.sub(r"[^A-Za-z0-9._-]+", "-", stem).strip(".-")[:80] or "file"
ext = re.sub(r"[^A-Za-z0-9]+", "", ext)[:10].lower()
name = f"{stem}.{ext}" if ext else stem

# Half random, half its signature: Kimono checks the signature before it looks
# in here, so a guessed link never wakes the sandbox.
nonce = secrets.token_hex(8)
key = os.environ.get("KIMONO_LINK_KEY", "")
token = nonce + (hmac.new(bytes.fromhex(key), nonce.encode(), hashlib.sha256).hexdigest()[:16] if key else secrets.token_hex(8))
folder = f"{LINKS}/{token}"
os.makedirs(folder, exist_ok=True)
shutil.copyfile(path, f"{folder}/{name}")
with open(f"{folder}/.expires", "w") as out:
    out.write(str(int(time.time() + hours * 3600)))

# Links older than a day are no use to anyone: tidy them away.
for old in os.listdir(LINKS):
    stamp = f"{LINKS}/{old}/.expires"
    try:
        if int(open(stamp).read().strip()) < time.time() - 3600:
            shutil.rmtree(f"{LINKS}/{old}", ignore_errors=True)
    except (OSError, ValueError):
        pass

shown = f"{hours:g} hour" + ("" if hours == 1 else "s")
print(f"{base}/{token}/{urllib.parse.quote(name)}")
print(f"(public for {shown}; pass it to the tool, not to the person)")
