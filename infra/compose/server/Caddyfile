{
	email {$ACME_EMAIL}
	servers {
		# Only tunnel connectors may speak for the client, so only kimono-tunnel,
		# which no app joins: an app could otherwise claim any visitor's address
		# to sign-in. The range is the network's
		# container allocation (compose.yml), which leaves out its gateway: with
		# Docker's userland proxy, a direct visitor arrives from the gateway and
		# could otherwise claim any address in X-Forwarded-For.
		trusted_proxies static 10.89.2.128/25
	}
}

# Defaults only: an application that sends its own value for one of these
# keeps it.
(security_headers) {
	header {
		?Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
	}
}

{$AUTHENTIK_DOMAIN} {
	encode zstd gzip
	import security_headers

	handle /static/kimono/theme.css {
		rewrite * /api/brand/theme.css
		reverse_proxy portal:3000
	}

	handle_path /static/kimono/* {
		header Cache-Control "no-cache"
		root * /srv/kimono-brand
		file_server
	}

	handle {
		reverse_proxy authentik-server:9000
	}
}

{$KIMONO_PORTAL_DOMAIN} {
	encode zstd gzip
	import security_headers

	# The appliance serves its own installer so a new device can join the mesh
	# without depending on GitHub being reachable.
	handle /install.sh {
		header Content-Type "text/x-shellscript"
		header Cache-Control "no-cache"
		root * /srv/kimono-brand
		file_server
	}

	handle {
		reverse_proxy portal:3000
	}

	# On a first boot the Portal waits minutes for Authentik's migrations.
	# Until it answers, show a page that reloads itself once it does.
	handle_errors 502 503 504 {
		# Error routes don't run the site's own directives.
		import security_headers
		root * /srv/kimono-brand
		rewrite * /kimono-starting.html
		header Cache-Control "no-store"
		header X-Kimono-Starting "1"
		header Retry-After "5"
		file_server {
			status 503
		}
	}
}

http://{$MESH_DOMAIN} {
	import security_headers

	handle /generate_204 {
		respond 204
	}

	redir https://{host}{uri}
}

{$MESH_DOMAIN} {
	import security_headers

	handle /generate_204 {
		respond 204
	}

	reverse_proxy headscale:8080 {
		header_up True-Client-IP {remote_host}
		header_up X-Real-IP {remote_host}
	}
}

# Hostnames published without a tunnel. The Portal writes one file per exposure
# and the reconciler reloads Caddy; a glob that matches nothing is not an error.
import /etc/caddy/sites/caddy-*.caddy
