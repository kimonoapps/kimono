<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<!-- Its own first: still where its sign-in is kept. -->
		<string>$(AppIdentifierPrefix)app.kimono.watch</string>
		<string>$(AppIdentifierPrefix)app.kimono.shared</string>
	</array>
</dict>
</plist>
