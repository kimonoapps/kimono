{
  "apiVersion": "apps.kimono.dev/v1alpha1",
  "kind": "AppDefinition",
  "metadata": {
    "id": "kimono-watch",
    "name": "Kimono Watch",
    "shortName": "Watch",
    "description": "Films, series and anime for the household, streamed on demand.",
    "category": "Media",
    "version": "0.1.0",
    "icon": "icon.svg",
    "colors": [
      "#a84d63",
      "#2a1d22",
      "#e2a0a8"
    ],
    "glyph": "play"
  },
  "spec": {
    "integration": "native",
    "services": [],
    "volumes": [],
    "configuration": [
      {
        "key": "usenet_host",
        "label": "Provider address",
        "kind": "text",
        "group": "usenet",
        "target": "settings",
        "description": "Your Usenet provider's news server, such as news.eweka.nl."
      },
      {
        "key": "usenet_port",
        "label": "Port",
        "kind": "number",
        "group": "usenet",
        "target": "settings",
        "default": "563"
      },
      {
        "key": "usenet_ssl",
        "label": "Encrypted",
        "kind": "toggle",
        "group": "usenet",
        "target": "settings",
        "default": "on"
      },
      {
        "key": "usenet_username",
        "label": "Username",
        "kind": "text",
        "group": "usenet",
        "target": "settings"
      },
      {
        "key": "usenet_password",
        "label": "Password",
        "kind": "secret",
        "group": "usenet",
        "target": "settings"
      },
      {
        "key": "usenet_connections",
        "label": "Connections",
        "kind": "number",
        "group": "usenet",
        "target": "settings",
        "default": "20",
        "description": "As many as your plan allows. Each stream uses several."
      },
      {
        "key": "indexer_url",
        "label": "Indexer address",
        "kind": "text",
        "group": "usenet",
        "target": "settings",
        "description": "Your Newznab indexer, such as https://api.nzbgeek.info."
      },
      {
        "key": "indexer_key",
        "label": "Indexer API key",
        "kind": "secret",
        "group": "usenet",
        "target": "settings"
      },
      {
        "key": "debrid_service",
        "label": "Debrid service",
        "kind": "select",
        "group": "debrid",
        "target": "settings",
        "default": "None",
        "description": "Plays torrents instantly from the service's servers. Good for anime.",
        "options": [
          "None",
          "Real-Debrid",
          "TorBox",
          "AllDebrid",
          "Premiumize"
        ]
      },
      {
        "key": "debrid_key",
        "label": "Debrid API key",
        "kind": "secret",
        "group": "debrid",
        "target": "settings"
      },
      {
        "key": "tmdb_token",
        "label": "TMDB key",
        "kind": "secret",
        "group": "catalog",
        "target": "settings",
        "description": "From themoviedb.org → Settings → API. Titles, artwork and episodes come from TMDB."
      },
      {
        "key": "region",
        "label": "Country",
        "kind": "text",
        "group": "catalog",
        "target": "settings",
        "default": "US",
        "description": "Age ratings follow this country first, such as US or GB."
      },
      {
        "key": "jikan_url",
        "label": "Jikan address",
        "kind": "text",
        "group": "catalog",
        "target": "settings",
        "default": "https://api.jikan.moe/v4",
        "description": "Where filler and recap episodes are looked up.",
        "advanced": true
      },
      {
        "key": "anime_map_url",
        "label": "Anime map",
        "kind": "text",
        "group": "catalog",
        "target": "settings",
        "default": "https://raw.githubusercontent.com/Fribb/anime-lists/master/anime-list-full.json",
        "description": "The list that connects TMDB to AniList and MyAnimeList.",
        "advanced": true
      }
    ],
    "managedEnvironment": [],
    "defaultNetworkPolicy": {
      "internetAccess": true,
      "allowedApps": []
    },
    "portalPath": "/watch",
    "setupReady": true
  }
}
