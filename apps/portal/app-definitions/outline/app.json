{
  "apiVersion": "apps.kimono.dev/v1alpha1",
  "kind": "AppDefinition",
  "metadata": {
    "id": "outline",
    "name": "Kimono Notes",
    "shortName": "Notes",
    "description": "Shared notes and household knowledge",
    "category": "Productivity",
    "version": "1.7.1",
    "icon": "icon.svg",
    "colors": ["#b56d78", "#5f3441", "#ecd2b7"]
  },
  "spec": {
    "integration": "connected",
    "services": [
      { "id": "web", "image": "docker.getoutline.com/outlinewiki/outline:1.7.1", "dependsOn": ["database", "redis"], "endpoint": { "id": "web", "port": 3000, "protocol": "http" }, "environment": {
        "NODE_ENV": "production", "URL": "https://{{hostname}}", "PORT": "3000",
        "SECRET_KEY": "{{secret.SECRET_KEY}}", "UTILS_SECRET": "{{secret.UTILS_SECRET}}",
        "DATABASE_URL": "postgres://outline:{{secret.DATABASE_PASSWORD}}@{{service.database}}:5432/outline", "PGSSLMODE": "disable",
        "REDIS_URL": "redis://{{service.redis}}:6379", "FILE_STORAGE": "local", "FILE_STORAGE_LOCAL_ROOT_DIR": "/var/lib/outline/data",
        "FILE_STORAGE_UPLOAD_MAX_SIZE": "{{config.FILE_STORAGE_UPLOAD_MAX_SIZE}}", "DEFAULT_LANGUAGE": "{{config.DEFAULT_LANGUAGE}}"
      } },
      { "id": "database", "image": "postgres:16-alpine", "internal": true, "environment": { "POSTGRES_DB": "outline", "POSTGRES_USER": "outline", "POSTGRES_PASSWORD": "{{secret.DATABASE_PASSWORD}}" } },
      { "id": "redis", "image": "redis:7.4-alpine", "internal": true }
    ],
    "volumes": [
      { "id": "database", "service": "database", "path": "/var/lib/postgresql/data", "backup": true },
      { "id": "redis", "service": "redis", "path": "/data", "backup": true },
      { "id": "uploads", "service": "web", "path": "/var/lib/outline/data", "backup": true }
    ],
    "identity": {
      "redirectUris": ["https://{{hostname}}/auth/oidc.callback"]
    },
    "configuration": [
      { "key": "DEFAULT_LANGUAGE", "label": "Language", "kind": "text", "group": "general", "default": "en_US", "description": "Default language for new users." },
      { "key": "FILE_STORAGE_UPLOAD_MAX_SIZE", "label": "Maximum upload size", "kind": "bytes", "group": "storage", "default": "262144000", "description": "Largest attachment users may upload." },
      { "key": "SMTP_HOST", "label": "SMTP host", "kind": "text", "group": "email", "advanced": true },
      { "key": "SMTP_PORT", "label": "SMTP port", "kind": "number", "group": "email", "default": "587", "advanced": true },
      { "key": "SMTP_USERNAME", "label": "SMTP username", "kind": "text", "group": "email", "advanced": true },
      { "key": "SMTP_PASSWORD", "label": "SMTP password", "kind": "secret", "group": "email", "advanced": true },
      { "key": "SMTP_FROM_EMAIL", "label": "From address", "kind": "email", "group": "email", "advanced": true },
      { "key": "LOG_LEVEL", "label": "Log level", "kind": "select", "group": "diagnostics", "default": "info", "options": ["error", "warn", "info", "debug"], "advanced": true }
    ],
    "managedEnvironment": ["URL", "PORT", "SECRET_KEY", "UTILS_SECRET", "DATABASE_URL", "PGSSLMODE", "REDIS_URL", "FILE_STORAGE", "FILE_STORAGE_LOCAL_ROOT_DIR", "OIDC_CLIENT_ID", "OIDC_CLIENT_SECRET", "OIDC_AUTH_URI", "OIDC_TOKEN_URI", "OIDC_USERINFO_URI", "OIDC_LOGOUT_URI", "OIDC_USERNAME_CLAIM", "OIDC_DISPLAY_NAME", "OIDC_SCOPES"],
    "defaultNetworkPolicy": { "internetAccess": true, "allowedApps": [] }
  }
}
