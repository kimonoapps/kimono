{
  "apiVersion": "apps.kimono.dev/v1alpha1",
  "kind": "AppDefinition",
  "metadata": {
    "id": "forgejo",
    "name": "Kimono Git",
    "shortName": "Git",
    "description": "Self-hosted Git repositories, code review, and CI",
    "category": "Development",
    "version": "16.0.3",
    "icon": "icon.svg",
    "colors": [
      "#8a6a4a",
      "#3f3027",
      "#ead9c4"
    ],
    "glyph": "git"
  },
  "spec": {
    "integration": "connected",
    "services": [
      {
        "id": "web",
        "image": "codeberg.org/forgejo/forgejo:16.0.3",
        "endpoint": {
          "id": "web",
          "port": 3000,
          "protocol": "http"
        },
        "environment": {
          "USER_UID": "1000",
          "USER_GID": "1000",
          "FORGEJO__server__ROOT_URL": "https://{{hostname}}",
          "FORGEJO__server__PROTOCOL": "http",
          "FORGEJO__server__HTTP_PORT": "3000",
          "FORGEJO__database__DB_TYPE": "sqlite3",
          "FORGEJO__database__PATH": "/data/gitea/forgejo.db",
          "FORGEJO__security__INSTALL_LOCK": "true",
          "FORGEJO__service__ENABLE_NOTIFY_MAIL": "false",
          "FORGEJO__oauth2_client__ENABLE_AUTO_REGISTRATION": "true",
          "FORGEJO__oauth2_client__USERNAME": "preferred_username",
          "FORGEJO__oauth2_client__OPENID_CONNECT_SCOPES": "profile email"
        }
      }
    ],
    "volumes": [
      {
        "id": "data",
        "service": "web",
        "path": "/data",
        "backup": true,
        "backupLabel": "Repositories and Forgejo data",
        "backupDescription": "Git repositories, database, attachments, SSH keys, and application configuration."
      }
    ],
    "identity": {
      "redirectUris": [
        "https://{{hostname}}/user/oauth2/Kimono/callback"
      ],
      "environment": {
        "FORGEJO__oauth2_client__OPENID_CONNECT_SCOPES": "openid profile email"
      }
    },
    "bootstrap": {
      "service": "web",
      "user": "git",
      "environment": {
        "KIMONO_ADMIN_USER": "kimono-ai",
        "KIMONO_ADMIN_EMAIL": "kimono-ai@{{hostname}}",
        "KIMONO_ADMIN_PASSWORD": "{{secret.ADMIN_PASSWORD}}",
        "KIMONO_OIDC_CLIENT_ID": "{{oidc.clientId}}",
        "KIMONO_OIDC_CLIENT_SECRET": "{{oidc.clientSecret}}",
        "KIMONO_OIDC_DISCOVERY": "{{oidc.issuer}}.well-known/openid-configuration"
      },
      "script": [
        "# Wait for the server: the command line must not race its first start.",
        "tries=0",
        "until wget -q -O /dev/null http://localhost:3000/api/healthz; do",
        "  tries=$((tries + 1))",
        "  if [ \"$tries\" -ge 30 ]; then echo 'Forgejo is still starting.' >&2; exit 75; fi",
        "  sleep 2",
        "done",
        "# Kimono's own administrator, which Kimono AI works as.",
        "if forgejo admin user list --admin | awk 'NR > 1 { print $2 }' | grep -qx \"$KIMONO_ADMIN_USER\"; then",
        "  forgejo admin user change-password --username \"$KIMONO_ADMIN_USER\" --password \"$KIMONO_ADMIN_PASSWORD\" --must-change-password=false >/dev/null",
        "else",
        "  forgejo admin user create --admin --username \"$KIMONO_ADMIN_USER\" --email \"$KIMONO_ADMIN_EMAIL\" --password \"$KIMONO_ADMIN_PASSWORD\" --must-change-password=false >/dev/null",
        "fi",
        "# Sign in with Kimono, once Kimono has registered Forgejo with its identity provider.",
        "[ -n \"$KIMONO_OIDC_CLIENT_ID\" ] || exit 0",
        "source_id=$(forgejo admin auth list | awk -F '\\t' '$2 == \"Kimono\" { print $1 }')",
        "set -- --name Kimono --provider openidConnect --key \"$KIMONO_OIDC_CLIENT_ID\" --secret \"$KIMONO_OIDC_CLIENT_SECRET\" --auto-discover-url \"$KIMONO_OIDC_DISCOVERY\" --scopes openid --scopes profile --scopes email",
        "if [ -z \"$source_id\" ]; then forgejo admin auth add-oauth \"$@\"; else forgejo admin auth update-oauth --id \"$source_id\" \"$@\"; fi"
      ]
    },
    "configuration": [
      {
        "key": "FORGEJO__service__DISABLE_REGISTRATION",
        "label": "Disable registration",
        "kind": "toggle",
        "group": "general",
        "default": "on",
        "description": "Prevent unauthenticated users from creating accounts."
      },
      {
        "key": "FORGEJO__repository__DEFAULT_BRANCH",
        "label": "Default branch",
        "kind": "text",
        "group": "general",
        "default": "main",
        "description": "Default branch name for newly created repositories."
      },
      {
        "key": "FORGEJO__service__REQUIRE_SIGNIN_VIEW",
        "label": "Require sign-in",
        "kind": "toggle",
        "group": "general",
        "default": "off",
        "description": "Require users to sign in before viewing repositories."
      },
      {
        "key": "FORGEJO__log__LEVEL",
        "label": "Log level",
        "kind": "select",
        "group": "diagnostics",
        "default": "Info",
        "options": [
          "Trace",
          "Debug",
          "Info",
          "Warn",
          "Error"
        ],
        "advanced": true
      }
    ],
    "managedEnvironment": [
      "USER_UID",
      "USER_GID",
      "FORGEJO__server__ROOT_URL",
      "FORGEJO__server__PROTOCOL",
      "FORGEJO__server__HTTP_PORT",
      "FORGEJO__database__DB_TYPE",
      "FORGEJO__database__PATH",
      "FORGEJO__security__INSTALL_LOCK",
      "FORGEJO__service__ENABLE_NOTIFY_MAIL",
      "FORGEJO__oauth2_client__ENABLE_AUTO_REGISTRATION",
      "FORGEJO__oauth2_client__USERNAME",
      "FORGEJO__oauth2_client__OPENID_CONNECT_SCOPES",
      "FORGEJO__service__DISABLE_REGISTRATION",
      "FORGEJO__repository__DEFAULT_BRANCH",
      "FORGEJO__service__REQUIRE_SIGNIN_VIEW",
      "FORGEJO__log__LEVEL"
    ],
    "defaultNetworkPolicy": {
      "internetAccess": true,
      "allowedApps": []
    },
    "backups": [
      {
        "id": "database",
        "label": "Forgejo database",
        "description": "Online SQLite export of users, issues, and repository metadata.",
        "method": "sqlite",
        "enabledByDefault": true,
        "volume": "data",
        "paths": [
          "gitea/forgejo.db"
        ]
      },
      {
        "id": "files",
        "label": "Repositories and configuration",
        "description": "Repositories, attachments, SSH keys, and configuration; database is a separate item.",
        "method": "files",
        "enabledByDefault": true,
        "volume": "data",
        "paths": [
          "."
        ],
        "exclude": [
          "gitea/forgejo.db",
          "gitea/forgejo.db-wal",
          "gitea/forgejo.db-shm",
          "gitea/forgejo.db-journal"
        ]
      }
    ]
  }
}
