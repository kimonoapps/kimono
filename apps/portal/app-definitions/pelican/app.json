{
  "apiVersion": "apps.kimono.dev/v1alpha1",
  "kind": "AppDefinition",
  "metadata": {
    "id": "pelican",
    "name": "Kimono Hosting",
    "shortName": "Hosting",
    "description": "Game servers and their players, managed with Pelican",
    "category": "Games",
    "version": "1.0.0-beta38",
    "icon": "icon.svg",
    "colors": ["#4f7794", "#294458", "#d8e4e9"]
  },
  "spec": {
    "integration": "connected",
    "services": [
      {
        "id": "panel",
        "image": "ghcr.io/pelican/panel:v1.0.0-beta38",
        "endpoint": { "id": "web", "port": 80, "protocol": "http" },
        "environment": {
          "APP_URL": "https://{{hostname}}",
          "APP_ENV": "production",
          "APP_DEBUG": "false",
          "BEHIND_PROXY": "true",
          "XDG_DATA_HOME": "/pelican-data",
          "MAIL_DRIVER": "log"
        }
      }
    ],
    "volumes": [
      { "id": "data", "service": "panel", "path": "/pelican-data", "backup": true },
      { "id": "plugins", "service": "panel", "path": "/var/www/html/plugins", "backup": true },
      { "id": "logs", "service": "panel", "path": "/var/www/html/storage/logs", "backup": false }
    ],
    "identity": {
      "redirectUris": ["https://{{hostname}}/auth/oauth/callback/authentik"],
      "environment": {
        "OAUTH_AUTHENTIK_ENABLED": "true",
        "OAUTH_AUTHENTIK_CLIENT_ID": "{{oidc.clientId}}",
        "OAUTH_AUTHENTIK_CLIENT_SECRET": "{{oidc.clientSecret}}",
        "OAUTH_AUTHENTIK_BASE_URL": "{{oidc.baseUrl}}",
        "OAUTH_AUTHENTIK_DISPLAY_NAME": "Kimono",
        "OAUTH_AUTHENTIK_DISPLAY_COLOR": "#4f7794",
        "OAUTH_AUTHENTIK_SHOULD_CREATE_MISSING_USERS": "true",
        "OAUTH_AUTHENTIK_SHOULD_LINK_MISSING_USERS": "true",
        "AUTH_DISABLE_PASSWORD_LOGIN": "false"
      }
    },
    "configuration": [
      {
        "key": "TRUSTED_PROXIES",
        "label": "Trusted proxy networks",
        "kind": "text",
        "group": "network",
        "default": "172.16.0.0/12",
        "description": "Docker network ranges allowed to supply forwarded HTTPS and client-address headers.",
        "advanced": true
      }
    ],
    "managedEnvironment": ["APP_URL", "APP_ENV", "APP_DEBUG", "BEHIND_PROXY", "XDG_DATA_HOME", "MAIL_DRIVER", "OAUTH_AUTHENTIK_ENABLED", "OAUTH_AUTHENTIK_CLIENT_ID", "OAUTH_AUTHENTIK_CLIENT_SECRET", "OAUTH_AUTHENTIK_BASE_URL", "OAUTH_AUTHENTIK_DISPLAY_NAME", "OAUTH_AUTHENTIK_DISPLAY_COLOR", "OAUTH_AUTHENTIK_SHOULD_CREATE_MISSING_USERS", "OAUTH_AUTHENTIK_SHOULD_LINK_MISSING_USERS", "AUTH_DISABLE_PASSWORD_LOGIN"],
    "manualSetup": {
      "title": "Finish in Pelican",
      "description": "Kimono runs and publishes the unmodified Pelican panel and configures Sign in with Kimono automatically. Pelican keeps its own installer, server templates, permissions, and node credentials.",
      "steps": [
        "After the panel starts, open its /installer path and create the first local administrator. Keep that login as a recovery path for identity outages.",
        "Keep a separate protected copy of the APP_KEY stored in Pelican's persistent data.",
        "Create each node in Pelican, then install Wings on that machine with the configuration Pelican provides. Kimono does not provision or manage Wings nodes."
      ]
    },
    "defaultNetworkPolicy": { "internetAccess": true, "allowedApps": [] }
  }
}
