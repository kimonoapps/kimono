{
  "name": "@kimono/portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:tools": "node --test scripts/test-tools.mjs",
    "test:mobile-app": "node --test scripts/test-mobile-app.mjs",
    "test:tunnels": "node --test scripts/test-tunnel-settings.mjs",
    "test:account": "node --test scripts/test-account.mjs",
    "test:drive": "node --test scripts/test-drive.mjs",
    "test:watch": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs --test scripts/test-watch.mjs scripts/test-watch-sources.mjs",
    "test:books": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs --test scripts/test-books.mjs",
    "test:books-convert": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs --test scripts/test-books-convert.mjs",
    "test:friends": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs --test scripts/test-friends.mjs",
    "test:notes": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs --test scripts/test-notes.mjs",
    "test:outline-import": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs --test scripts/test-outline-import.mjs",
    "test:notes-mcp": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs --test scripts/test-notes-mcp.mjs",
    "test:marks": "node --test scripts/test-marks.mjs",
    "test:app-updates": "node --test scripts/test-app-updates.mjs",
    "test:testflight": "node --test scripts/test-testflight.mjs",
    "test:code": "node --import ./scripts/ts-resolve.mjs --test scripts/test-code.mjs",
    "test:skills": "node --import ./scripts/ts-resolve.mjs --test scripts/test-skills.mjs",
    "test:artifacts": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs --conditions=react-server --test scripts/test-artifacts.mjs",
    "test:composio": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs --conditions=react-server --test scripts/test-composio.mjs",
    "test:history": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs --conditions=react-server --test scripts/test-history.mjs",
    "test:mesh-policy": "node --experimental-transform-types --test scripts/test-mesh-policy.mjs",
    "test:sharing": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs --conditions=react-server --test scripts/test-sharing.mjs",
    "test:attachments": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs --conditions=react-server --test scripts/test-big-attachments.mjs",
    "test:access": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs --conditions=react-server --test scripts/test-access.mjs && node --experimental-transform-types --import ./scripts/ts-resolve.mjs --conditions=react-server --test scripts/test-access-flow.mjs",
    "test:git-owners": "node --experimental-transform-types --import ./scripts/ts-resolve.mjs --conditions=react-server --test scripts/test-git-owners.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@codemirror/collab": "6.1.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@kimono/account": "workspace:*",
    "@kimono/app-sdk": "workspace:*",
    "@kimono/artifacts": "workspace:*",
    "@kimono/ui": "workspace:*",
    "epubjs": "0.3.93",
    "hls.js": "1.6.19",
    "katex": "0.19.1",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@iconify-json/logos": "1.2.18",
    "@iconify-json/material-icon-theme": "1.2.77",
    "@iconify-json/vscode-icons": "1.2.95",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/katex": "0.16.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2"
  }
}
