FROM cloudflare/cloudflared:2026.8.0 AS cloudflared

FROM node:24-alpine AS build
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches patches
COPY apps/portal/package.json apps/portal/package.json
COPY packages/account/package.json packages/account/package.json
COPY packages/app-sdk/package.json packages/app-sdk/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN pnpm install --frozen-lockfile
COPY apps/portal apps/portal
COPY packages packages
RUN pnpm --filter @kimono/portal build

FROM node:24-alpine
# The release tag this image was built from, shown in the Portal and compared
# against the newest release. Local builds are "dev".
ARG KIMONO_VERSION=dev
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 KIMONO_VERSION=$KIMONO_VERSION

# Links this image to its repository, which is what grants the repository's
# own Actions token permission to publish it.
LABEL org.opencontainers.image.source=https://github.com/kimonoapps/kimono
WORKDIR /app
COPY --from=build /app/apps/portal/.next/standalone ./
COPY --from=build /app/apps/portal/.next/static ./apps/portal/.next/static
COPY --from=build /app/apps/portal/public ./apps/portal/public
COPY --from=build /app/apps/portal/app-definitions /usr/share/kimono/app-definitions
COPY --from=cloudflared /usr/local/bin/cloudflared /usr/local/bin/cloudflared
# Watch's YouTube shows (apps/portal/src/lib/watch/youtube.ts): yt-dlp finds
# and fetches them, ffmpeg puts HD picture and sound in one file. YouTube
# changes often: move this pin forward when episodes stop resolving.
ARG YTDLP_VERSION=2026.10.26
ARG YTDLP_SHA256=e51e69e89489f199530f13d32a4342da3ddb2cf34842f364603a066db05afbf3
# Books' PDF → EPUB (apps/portal/src/lib/books/convert): poppler's pdftohtml,
# pdftoppm and pdfinfo: 11 MB beside ffmpeg, whose libraries they share.
RUN apk add --no-cache ffmpeg python3 poppler-utils \
 && wget -qO /usr/local/bin/yt-dlp "https://github.com/yt-dlp/yt-dlp/releases/download/${YTDLP_VERSION}/yt-dlp" \
 && echo "${YTDLP_SHA256}  /usr/local/bin/yt-dlp" | sha256sum -c - \
 && chmod 755 /usr/local/bin/yt-dlp
USER node
EXPOSE 3000
CMD ["node", "apps/portal/server.js"]
